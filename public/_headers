# ==============================================================================
# Cloudflare Pages / Workers Global Security Headers
# Mitigación perimetral de Clickjacking, MIME-Sniffing, XSS y Fuga de Referer
# ==============================================================================

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://web-production-aab12.up.railway.app; frame-ancestors 'none'; object-src 'none'; base-uri 'self';

/assets/*
  Cache-Control: public, max-age=31536000, immutable
